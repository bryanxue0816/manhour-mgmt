// Prisma schema - v1 dev uses SQLite via an explicit driver adapter (Prisma 7 requirement).
// Migration to PostgreSQL is deferred; every SQLite-specific compromise is tagged `// [PG]`
// with the exact change required when the provider is switched.
//
// SQLite limitations worked around in this file:
//   1. No `enum`            -> String columns constrained by TypeScript union types
//   2. No `Decimal`         -> Float (double precision is exact for hours <= 1e5 with 1 decimal)
//   3. No date-only type    -> DateTime required to be a calendar day at UTC midnight,
//                              enforced by lib/db/date.ts#assertCalendarDay (rejects a
//                              value carrying a time component; it does NOT truncate -
//                              callers holding an instant convert via businessDayOf)
//   4. No partial indexes   -> FiscalYear.isCurrent uniqueness enforced in a transaction
//   5. No native `@db.*` types
//   6. `createMany` has no skipDuplicates -> seed uses upsert loops inside one transaction
//   7. No case-insensitive filters (`mode: 'insensitive'`)
//   8. No Json / scalar-list columns

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

/// A department (部). 7 rows for FY2026, imported from FY26组织结构.xlsx.
/// `name` is the natural key: org changes are applied as a full Excel re-upload
/// with upsert-by-name, and history is never deleted (D-153).
model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?  @unique
  /// Excel row order. Drives UI ordering; the dashboard addresses departments
  /// by array index, so this must stay stable across re-imports.
  sortOrder    Int
  /// Department-level owner (部长). Source rows with an empty 課名 column (D-150).
  managerName  String?
  managerEmail String?
  createdAt    DateTime @default(now())

  sections Section[]

  @@index([sortOrder])
  @@map("department")
}

/// A section (課). 24 rows for FY2026. All plan/actual hours attach here -
/// it is the finest granularity the dashboard drills down to.
model Section {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  sortOrder    Int
  managerName  String?
  /// Deliberately NOT unique: one person may own several sections (D-150).
  managerEmail String?
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  plans       Plan[]
  actuals     Actual[]
  adjustments ActualAdjustment[]
  aliases     SectionAlias[]
  attendance  AttendanceRaw[]

  /// (部, 課) is the composite natural key used by the re-import upsert (D-153).
  @@unique([departmentId, name])
  @@index([departmentId, sortOrder])
  @@map("section")
}

// ---------------------------------------------------------------------------
// Fiscal year
// ---------------------------------------------------------------------------

/// A fiscal year running April 1 -> March 31. Month numbers on Plan/Actual are
/// 1..12 relative to this window, where 1 = April (D-004).
model FiscalYear {
  id        String   @id @default(cuid())
  name      String   @unique
  year      Int      @unique
  startDate DateTime
  endDate   DateTime
  /// At most one row may be true. SQLite has no partial unique index, so this is
  /// enforced by fiscal-year.repo.ts#setCurrentFiscalYear inside a transaction.
  /// [PG] replace with: CREATE UNIQUE INDEX ... ON fiscal_year (is_current) WHERE is_current
  isCurrent Boolean  @default(false)

  plans       Plan[]
  actuals     Actual[]
  adjustments ActualAdjustment[]

  @@map("fiscal_year")
}

// ---------------------------------------------------------------------------
// Plan (target hours, manually maintained)
// ---------------------------------------------------------------------------

/// Monthly planned and challenge hours per section.
/// 288 rows per fiscal year (24 sections x 12 months).
model Plan {
  id             String   @id @default(cuid())
  sectionId      String
  fiscalYearId   String
  /// 1..12, where 1 = April. Guarded by assertFiscalMonth() at every write site.
  month          Int
  /// [PG] Decimal @db.Decimal(12, 2)
  plannedHours   Float
  /// Independently entered business data - never derived from plannedHours.
  /// May legally equal or exceed plannedHours (D-151).
  /// [PG] Decimal @db.Decimal(12, 2)
  challengeHours Float
  updatedAt      DateTime @updatedAt
  updatedBy      String   @default("system")

  section    Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear      @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  changeLogs PlanChangeLog[]

  @@unique([sectionId, fiscalYearId, month])
  @@index([fiscalYearId, month])
  @@map("plan")
}

/// Append-only audit trail for plan edits (D-143). Written only by
/// lib/db/plan-change-log.repo.ts, always inside the same transaction as the
/// plan write it records - see upsertPlanWithAudit().
model PlanChangeLog {
  id          String   @id @default(cuid())
  planId      String
  /// 'planned_hours' | 'challenge_hours'
  field       String
  beforeValue Float
  afterValue  Float
  reason      String?
  changedAt   DateTime @default(now())
  changedBy   String

  /// Restrict, not Cascade: this table IS the audit trail D-144 requires, so deleting a
  /// Plan must not be allowed to take its own evidence with it. Cascade made the delete
  /// succeed silently and the history simply vanish - no error, nothing to notice. A
  /// Plan that has recorded changes now cannot be deleted at all, which is the intended
  /// answer: retire it by other means and keep the trail.
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, changedAt])
  @@map("plan_change_log")
}

// ---------------------------------------------------------------------------
// Actual (aggregated attendance hours)
// ---------------------------------------------------------------------------

/// Monthly aggregated actual hours per section. This IS the MonthlyAggregate of
/// D-126 ("the dashboard always reads the aggregate, never the raw detail") -
/// deliberately one table, not two, so Phase 4 writes straight into it.
/// Recomputed from AttendanceRaw by lib/attendance/calc.ts (D-111 / D-126).
model Actual {
  id             String    @id @default(cuid())
  sectionId      String
  fiscalYearId   String
  month          Int
  /// D-104: columns R + S of the attendance export.
  /// [PG] Decimal @db.Decimal(12, 2)
  personnelHours Float     @default(0)
  /// D-105: Z+AA+AB+AD-AF-AV-AY-BA. Negative values are legal.
  /// [PG] Decimal @db.Decimal(12, 2)
  overtimeHours  Float     @default(0)
  /// personnelHours + overtimeHours. Denormalised on purpose: D-126 requires the
  /// dashboard to read the aggregate without query-time arithmetic, and keeping
  /// the sum as a column makes "negative overtime pushed total below personnel"
  /// anomalies directly queryable.
  /// [PG] Decimal @db.Decimal(12, 2)
  totalHours     Float     @default(0)
  /// D-198: how this row's hours were produced. "fold" = derived from attendance_raw
  /// by rebuildMonthlyActuals(); "manual" = a historical baseline typed in by hand for
  /// months that predate the system going live, where no attendance_raw rows exist.
  ///
  /// Load-bearing, not descriptive: manual rows carry the whole month in totalHours with
  /// personnelHours/overtimeHours left at 0 (the split is unavailable retroactively), so
  /// anything that recomputes a month MUST refuse to touch a month holding manual rows -
  /// a blind rebuild would find no attendance and zero the baseline out, silently
  /// breaking D-141's 剩余 = 计划 − 实绩.
  ///
  /// SQLite has no enum, so this is TEXT and lib/db/actual-source.ts IS the constraint.
  /// [PG] becomes a real enum.
  source         String    @default("fold")
  sourceFile     String?
  fetchedAt      DateTime?
  lastComputedAt DateTime  @updatedAt

  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([sectionId, fiscalYearId, month])
  @@index([fiscalYearId, month])
  @@map("actual")
}

/// D-233: hours that belong in 实绩 but have no attendance detail behind them.
///
/// Two requirements arrive at the same shape. 8月 is a go-live boundary month - 26-31 came
/// from the automatic fetch, 1-25 exists only as a per-section monthly total - and from
/// now on the folded figure will sometimes disagree with a hand-kept tally. Both are
/// "a section-month owes N more hours than the detail can account for".
///
/// A COLUMN ON Actual WAS REJECTED, for a reason that is not stylistic:
/// rebuildMonthlyActuals() ends with deleteMany({ sectionId: { notIn: aggregates } }), so a
/// section with no attendance rows that month loses its Actual row entirely. Carried as a
/// column, 1-25's back-fill would silently vanish for exactly those sections. A separate
/// table cannot be reached by that delete.
///
/// Consequences that follow from this being a separate table, all deliberate:
///   - Readers must treat the row set as Actual UNION Adjustment, not Actual alone. A
///     section-month may hold an adjustment and no folded row at all.
///   - buildOrgRoot() does `slot.actual = row.totalHours` (assignment, not +=), so the
///     merge MUST collapse to one row per (section, month) before it reaches any consumer.
///
/// D-141 (剩余 = 计划 − 实绩) is unchanged; this refines what 实绩 counts. It is
/// folded hours + the sum of un-revoked adjustments. Nothing else changed meaning.
model ActualAdjustment {
  id           String @id @default(cuid())
  sectionId    String
  fiscalYearId String
  /// 1..12, where 1 = April. Guarded by assertFiscalMonth() at every write site.
  month        Int

  /// Total hours only - no 人员/加班 split. The source data for both use cases is a
  /// single per-section figure (D-233), and inventing a split would fabricate precision
  /// that was never measured.
  ///
  /// Signed on purpose: a hand tally that comes in BELOW the folded figure is corrected
  /// by a negative adjustment, which is the same operation as a positive one. Clamping
  /// to zero would make one of the two directions unrepresentable.
  /// [PG] Decimal @db.Decimal(12, 2)
  hours        Float

  /// The section-month's folded `Actual.totalHours` AT THE MOMENT this slip was written.
  /// Not displayed, not summed - it exists solely so the read side can detect that the
  /// base moved out from under the slip.
  ///
  /// WHAT IT CATCHES. 8月 is a `fold` month, so rebuildMonthlyActuals()'s D-198 guard
  /// (which only refuses `manual` months) will happily re-fold it. If 8月1-25's
  /// attendance detail ever arrives - a scheduled fetch of a back-dated file, or a manual
  /// /actuals/import upload, neither of which filters by date - `totalHours` jumps from
  /// ~6870 to ~31000 while the un-revoked slips keep adding their hand-tallied hours on
  /// top. The result is roughly double-counted, raises no error, and writes no log. This
  /// snapshot is the only way to notice.
  ///
  /// 0, NOT null, when no `Actual` row exists for the section-month: "no folded row" means
  /// the fold contributed zero, and a later real fold moves it off zero and trips the
  /// check. Recording null there would disable detection for exactly the case that needs
  /// it most - a slip entered before any detail existed.
  ///
  /// Nullable only so a row inserted outside this code path (a hand-written SQL back-fill)
  /// can say "base unknown" rather than lie about it. Null means NOT CHECKED, never
  /// "unchanged".
  /// [PG] Decimal @db.Decimal(12, 2)
  foldHoursAtEntry Float?

  /// MANDATORY, unlike MasterDataChangeLog.reason. The whole value of this table is that
  /// a discrepancy stays visible and explicable; a null reason turns a row back into the
  /// untraceable hand-edit it was built to replace. The UI enforces non-empty (D-214's
  /// precedent on PlanChangeLog).
  reason       String

  /// Always "admin" - a placeholder, not an identity. Never present it as evidence of
  /// who acted.
  changedBy    String   @default("admin")
  changedAt    DateTime @default(now())

  /// Soft revoke, mirroring AttendanceRaw.supersededAt (D-229). Correcting an adjustment
  /// is revoke-then-insert, never an in-place edit of `hours`: an overwrite leaves no
  /// trace, which is the failure this table exists to prevent. No approval step gates the
  /// write (the operator's explicit choice) - the trail is the only control, so it must
  /// survive the correction.
  revokedAt    DateTime?
  revokedBy    String?

  section    Section    @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  /// NO unique key on (sectionId, fiscalYearId, month), unlike Actual. One section-month
  /// legitimately carries several adjustments from unrelated events - 8月's go-live
  /// back-fill and a discrepancy found in October are two facts, not one fact edited
  /// twice. Uniqueness here would force the second to overwrite the first.
  @@index([fiscalYearId, month])
  @@index([sectionId, fiscalYearId, month])
  @@map("actual_adjustment")
}

// ---------------------------------------------------------------------------
// Reference data
// ---------------------------------------------------------------------------

/// System key-value config (e.g. daily_standard_hours = 8).
model Config {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("config")
}

/// Working-day calendar (D-202). Used to prorate monthly targets by elapsed
/// working days rather than calendar days.
///
/// DORMANT - 0 rows, no readers, no writers (D-168, 2026-08-07). A working day is
/// whatever the daily attendance upload says it is; v1 maintains no standalone
/// calendar. Kept for the documented re-introduction trigger (any requirement whose
/// denominator is 应出勤天数 / 工作日数). `remark` is unused for the same reason:
/// a computed day type has no author to record.
/// See src/lib/db/work-calendar.repo.ts for the full rationale.
model WorkCalendar {
  /// Date-only semantics. SQLite has no DATE type, so every value must ALREADY be a
  /// calendar day at UTC midnight: lib/db/date.ts#assertCalendarDay rejects anything
  /// carrying a time component rather than truncating it, on both write and read.
  /// A timestamped value would be a distinct primary key and silently duplicate the day.
  /// [PG] add @db.Date
  date      DateTime @id
  /// '工作日' | '周末' | '节假日' | '年例休'
  dayType   String
  remark    String?
  updatedAt DateTime @updatedAt

  /// (dayType, date) not (dayType): every real query filters a type over a date range.
  /// Measured plan with the single-column index was
  /// `SEARCH work_calendar USING INDEX work_calendar_dayType_idx (dayType=?)` - the date
  /// range was then filtered by scanning the matched rows. Harmless at 0 rows today,
  /// linear in the type's row count once a full year is loaded.
  @@index([dayType, date])
  @@map("work_calendar")
}

/// Per-job-title exclusion rules for attendance aggregation (D-109).
/// Preseeded from the D-107 (personnel) and D-108 (overtime) exclusion sets, extended by
/// D-161 with 工场长 / 高级课长 and by D-238 with 项目经理 (5 -> 7 -> 8 rows). The sets are
/// NOT the same size: personnel exclusion applies to 3 titles (部长 / 项目课长 / 副总经理),
/// overtime exclusion to all 8 (every row). D-238 revised the personnel set itself:
/// 项目部长 left it and 项目课长 entered it, producing an apparent hierarchy inversion
/// (项目部长 sits above 项目课长 but its personnel hours count toward the section while
/// 项目课长's are excluded). Confirmed deliberate by the user; do not "fix" it.
///
/// jobTitle is matched by exact string with no alias table - unlike Section, which has
/// SectionAlias for a measured homoglyph trap. A title spelled 工場長 instead of 工场长
/// simply misses, and ruleVerdict() reports "not excluded" with no error anywhere.
model JobTitleRule {
  jobTitle              String   @id
  /// D-107: exclude this title's hours from personnelHours.
  excludePersonnelHours Boolean  @default(false)
  /// D-108: exclude this title's hours from overtimeHours.
  excludeOvertimeHours  Boolean  @default(false)
  remark                String?
  updatedAt             DateTime @updatedAt

  @@map("job_title_rule")
}

// ---------------------------------------------------------------------------
// Attendance import (Phase 4)
// ---------------------------------------------------------------------------

/// Maps an HR-export (部别, 课别) pair onto a Section when the two sides spell the
/// name differently. Exists because the strings are visually identical but are NOT
/// equal: the HR export writes 检查课 (查 = U+67E5) where the org master writes
/// 检査课 (査 = U+67FB). Measured on the real workbook: 25 rows, silently
/// unattributable, and silent in BOTH directions - the section reports zero actuals
/// while its hours pile up in the unattributed bucket. Neither side is "wrong", so
/// this is a translation table rather than a data fix on either master.
model SectionAlias {
  id            String   @id @default(cuid())
  /// 部别 exactly as it appears in the attendance export.
  hrDeptName    String
  /// 课别 exactly as it appears in the attendance export.
  hrSectionName String
  sectionId     String
  remark        String?
  createdAt     DateTime @default(now())

  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  /// One HR-side spelling resolves to exactly one Section.
  @@unique([hrDeptName, hrSectionName])
  @@index([sectionId])
  @@map("section_alias")
}

/// One attendance row per employee per day (D-122). The unique key is
/// (employeeNo, workDate), so re-importing the same day upserts in place and keeps
/// no version history - D-122 states the latest fetch is authoritative.
///
/// Stores the 10 formula input columns rather than only the derived totals. D-161
/// is the proof this matters: the exclusion lists grew after the fact, and with
/// only post-exclusion figures on hand the whole month would have to be re-fetched
/// from HR to recompute. With the inputs retained, Actual is rebuildable from the
/// database alone.
model AttendanceRaw {
  id           String @id @default(cuid())
  /// 工号. String, NOT Int: measured as a 6-digit string, and an Int would silently
  /// drop a leading zero if HR ever issues one.
  employeeNo   String
  employeeName String?
  /// 出勤日期. Arrives as an Excel 1900 serial number (measured: 46204) and is
  /// converted with the 1899-12-30 epoch, which absorbs Excel's 1900 leap-year bug.
  /// Date-only semantics, same contract as WorkCalendar.date: the value must ALREADY
  /// be a calendar day at UTC midnight (lib/db/date.ts#assertCalendarDay).
  /// [PG] add @db.Date
  workDate     DateTime

  /// 部别 / 课别 / 职务 / 员工类别 as exported, kept verbatim for traceability.
  /// hrSectionName is nullable: 35 measured rows carry no 课别 at all (支援人员 and
  /// department-level managers), and those rows must still be storable.
  hrDeptName       String
  hrSectionName    String?
  jobTitle         String?
  employeeCategory String?
  /// Resolved Section, via exact (部, 課) match then SectionAlias. NULL means the row
  /// could not be attributed to any section - it is deliberately still imported
  /// ("默认全额计入 + 未归属可见告警") and surfaces in the /actuals warning banner.
  sectionId        String?

  /// D-104 inputs: 请假时间 + 上班时数.
  leaveHours        Float @default(0)
  workHours         Float @default(0)
  /// D-105 additive inputs: 平时加班 + 休日双倍 + 节假加班 + 休日调休.
  normalOvertime    Float @default(0)
  restDayDouble     Float @default(0)
  holidayOvertime   Float @default(0)
  restDayCompensate Float @default(0)
  /// D-105 subtractive inputs: 调休假时数, 产假时数, 护理假时数, 流产假时数.
  compensatoryLeave Float @default(0)
  maternityLeave    Float @default(0)
  nursingLeave      Float @default(0)
  miscarriageLeave  Float @default(0)

  /// Derived per row, pre-exclusion. Denormalised for the same reason as
  /// Actual.totalHours: it makes a single employee's contribution directly
  /// queryable when an aggregate looks wrong.
  personnelHours Float @default(0)
  /// D-105 may legitimately be negative (measured: 课长 aggregates to -8).
  overtimeHours  Float @default(0)
  totalHours     Float @default(0)

  /// Exclusion verdict applied at import time, from JobTitleRule (D-109).
  excludedPersonnel Boolean @default(false)
  excludedOvertime  Boolean @default(false)

  sourceFile String
  importedAt DateTime @default(now())

  /// D-229 soft supersede. NULL means live; non-NULL means a LATER file for the same
  /// workDate no longer contained this (工号, 出勤日期), i.e. HR deleted the row.
  ///
  /// Row-level upsert (the @@unique below) already gives "duplicates are no-ops,
  /// later file wins" for inserts and updates, but it CANNOT express a deletion:
  /// overwriting only touches keys present in the incoming file, so a row HR dropped
  /// would survive as a ghost and keep feeding the monthly aggregate.
  ///
  /// Soft, not hard delete, because D-206 is "不做删除、长期保留" and the only DELETE in
  /// the codebase targets the recomputable monthly aggregate. Raw detail is NOT
  /// recomputable - hard-deleting it would erase the fact that HR once reported the
  /// row, which is exactly what the audit trail exists to preserve.
  ///
  /// Deliberately NOT indexed. Every read filters `workDate` range AND
  /// `supersededAt: null`; the existing @@index([workDate]) already narrows to one
  /// month, and supersededAt has near-zero selectivity (almost every row is NULL), so
  /// an index on it would cost write amplification and buy nothing.
  supersededAt DateTime?
  /// File that superseded this row, e.g. 日考勤数据260828_1500.csv. Answers "which
  /// file removed it, and when" - information that hard deletion destroys.
  supersededBy String?

  section Section? @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  /// D-122: idempotent upsert key. Re-import overwrites the same day in place.
  @@unique([employeeNo, workDate])
  @@index([workDate])
  @@index([sectionId, workDate])
  @@map("attendance_raw")
}

/// One row per fetch attempt (D-123), success or failure. Failures are recorded
/// rather than thrown away: D-228 fixed two scheduled fetches per day (09:05 and
/// 15:05, both carrying the PREVIOUS day), and the /actuals status panel has to show
/// that both ran. Two SUCCESS rows for one calendar day is the normal case, not a
/// retry - the earlier "06:00 then hourly retries until 18:00" scheme is void.
model ImportLog {
  id           String    @id @default(cuid())
  fileName     String
  /// Source mtime, used to tell "HR has not published today's file yet" apart from
  /// "the file is there but unreadable".
  fileMtime    DateTime?
  importedAt   DateTime  @default(now())
  /// 'SUCCESS' | 'FAILED' | 'PARTIAL' (D-123). SQLite has no enum; validated in the
  /// repo against IMPORT_STATUSES so a typo cannot become a fourth silent state.
  /// [PG] replace with a real enum
  status       String
  /// Rows actually written. 0 on FAILED.
  rowCount     Int       @default(0)
  /// D-229: rows this file superseded, i.e. rows HR deleted since the earlier fetch.
  /// Separate from rowCount, which only counts rows WRITTEN - without this column a
  /// data reduction is completely invisible on the audit page (D-226), and "15:00
  /// removed 3 people's day" is precisely the event an operator must be able to see.
  /// 0 whenever the sharp-drop guard skipped supersede, so 0 does not prove "nothing
  /// was removed" - read it together with warningMessage.
  supersededCount Int    @default(0)
  errorMessage String?
  /// D-222 completeness warning: the day's rows are valid but look incomplete, most
  /// likely because HR exported before the clock machines finished syncing. Kept out
  /// of `errorMessage`, whose contract is "null on a clean SUCCESS" - callers read a
  /// non-null there as "something went wrong", and a warning is neither.
  warningMessage String?
  /// Share of on-roll, not-on-leave, no-leave-hours rows with zero 上班时数, 0..1.
  /// Null when the export lacks 在职/是否休假, holds no rows, or the import FAILED.
  ///
  /// Recorded on every import that landed, not only when the warning fires: the 10%
  /// threshold is calibrated from a single day, and this series is what will replace it.
  unexplainedZeroRatio Float?
  /// 'schedule' | 'manual' | 'retry' (D-123).
  triggeredBy  String

  @@index([importedAt])
  @@index([status, importedAt])
  @@map("import_log")
}

/// Snapshot-level audit for master data edited through /admin (D-173).
///
/// Stores the FULL post-write state of one entity class as JSON, not a per-field
/// diff: `PlanChangeLog` cannot be reused because its before/after columns are
/// `Float`, and org/rule edits are strings and booleans. The pre-edit state is not
/// stored separately - the first write for an entity class emits a `baseline` row
/// first, so the state before any edit survives exactly once instead of being
/// duplicated on every subsequent write.
///
/// changedBy is ALWAYS the literal "admin" and is NOT an identity. D-180 added a
/// shared-password gate, so reaching a write now requires knowing one password -
/// but there is still exactly one account and no per-person identity (D-179 kept
/// the literal on purpose). This table answers "when was it changed to this", NOT
/// "who changed it". The same limitation is stated on /admin itself - operators
/// never read schema comments.
model MasterDataChangeLog {
  id        String   @id @default(cuid())
  /// 'organization' | 'job_title_rule'. SQLite has no enum; the repo is the only
  /// writer and constrains this to MASTER_DATA_ENTITIES.
  entity    String
  /// 'baseline' | 'create' | 'update'. No 'delete': D-172 withdrew the delete
  /// requirement outright, and all four inbound FKs are onDelete: Restrict.
  action    String
  /// Section name / department name / jobTitle. Deliberately NOT a foreign key -
  /// an audit row must outlive the row it describes, and a Restrict FK would also
  /// make the audit table block the very deletes it is meant to record.
  targetKey String
  /// Complete JSON snapshot of the entity class AFTER the write.
  snapshot  String
  /// Free-text why, OPTIONAL and usually null (D-184). Deliberately inconsistent
  /// with PlanChangeLog.reason, which the UI makes mandatory (D-214): plan hours are
  /// edited often and by several hands, while an org change is rare and its "why"
  /// is normally obvious from the snapshot. Forcing a reason here would only harvest
  /// the word "调整". A `baseline` row always carries null - it describes the state
  /// before anybody edited anything, so there is no reason to give.
  reason    String?
  changedAt DateTime @default(now())
  /// Always "admin"; a placeholder, not an identity. See the model docstring.
  changedBy String   @default("admin")

  @@index([entity, changedAt])
  @@map("master_data_change_log")
}
