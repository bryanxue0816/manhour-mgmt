# Prisma datasource URL.
# Phase 0-1 dev: SQLite (zero-dependency, file-based).
DATABASE_URL="file:./dev.db"

# Phase 2 switches to PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/manhour?schema=public"

# Dashboard data source switch (server-only, NOT NEXT_PUBLIC_).
# "mock" = Phase 1 in-memory fixtures | "db" = read from the database.
ORG_DATA_SOURCE=mock

# Shared administrator password. Leave empty and the app fails closed: every
# protected page reports that no password is configured and nobody gets in.
# Never commit a real value - .env is gitignored, this example file is not.
ADMIN_PASSWORD=

# HMAC key for signing the admin session cookie. Must be >= 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Missing or too short denies everyone rather than admitting everyone.
SESSION_SECRET=

# Marks the session cookie `secure`. Only set true where TLS actually terminates -
# a secure cookie is never sent back over plain HTTP, which locks admins out silently.
COOKIE_SECURE=false
