# Prisma datasource URL.
# Phase 0-1 dev: SQLite (zero-dependency, file-based).
DATABASE_URL="file:./dev.db"

# Phase 2 switches to PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/manhour?schema=public"

# Dashboard data source switch (server-only, NOT NEXT_PUBLIC_).
# "mock" = Phase 1 in-memory fixtures | "db" = read from the database.
ORG_DATA_SOURCE=mock
