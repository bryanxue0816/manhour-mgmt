# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# Production env. Only .env.production.example is tracked. Without this line
# .env.production would be committed - `.env` and `.env*.local` above do not
# match it.
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma local db & env
.env
*.db
*.db-journal

# Backup output from scripts/backup-db.mjs. The *.db line above already covers
# the files themselves; this keeps the directory out too.
/backups/

# Lock and log for scripts/auto-commit.mjs. Must stay ignored: the script skips a
# run when any changed file was touched recently, so its own log would keep the
# working tree permanently "just modified" and no auto-commit would ever fire.
/.autocommit/

# Local agent session outputs: subagent review scratch files, portable runbooks.
# Working notes only - never part of the shipped tree.
/.claude/out/
